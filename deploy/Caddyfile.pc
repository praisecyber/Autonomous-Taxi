{
	admin off
	auto_https disable_redirects
	skip_install_trust
	http_port {$TAXI_HTTP_PORT:8080}
	https_port {$TAXI_HTTPS_PORT:8443}
}
import routes.caddy
https://{$TAXI_DOMAIN:probix.localhost}:{$TAXI_HTTPS_PORT:8443} {
	bind {$TAXI_LISTEN_ADDRESS:127.0.0.1}
	tls internal
	import taxi_routes
}
http://{$TAXI_DOMAIN:probix.localhost}:{$TAXI_HTTP_PORT:8080} {
	bind {$TAXI_LISTEN_ADDRESS:127.0.0.1}
	redir https://{$TAXI_DOMAIN:probix.localhost}:{$TAXI_HTTPS_PORT:8443}{uri} 308
}
