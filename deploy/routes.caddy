(taxi_routes) {
	encode zstd gzip
	header {
		defer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Cache-Control no-store
	}
	@api path /api/* /ws/telemetry /docs /docs/* /openapi.json /redoc
	handle @api {
		reverse_proxy {$TAXI_API_UPSTREAM:backend:8000}
	}
	handle_path /static/* {
		root * {$TAXI_FRONTEND_ROOT:/srv}
		file_server
	}
	handle {
		root * {$TAXI_FRONTEND_ROOT:/srv}
		@operator path / /operator
		rewrite @operator /index.html
		@passenger path /passenger
		rewrite @passenger /passenger.html
		@admin path /admin
		rewrite @admin /admin.html
		@account path /account
		rewrite @account /account.html
		@diagnostics path /diagnostics
		rewrite @diagnostics /diagnostics.html
		file_server
	}
}
