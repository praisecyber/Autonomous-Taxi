# Local simulation only. Change the operator token before sharing the app.
TAXI_MODE=simulation
TAXI_OPERATOR_TOKEN=local-dev-only
TAXI_DATA_DIR=runtime
# auto allows the legacy operator token only before any accounts exist.
# Use 0 to disable it entirely; 1 is an explicit local-demo override.
TAXI_ALLOW_LEGACY_TOKEN=auto
# Set to 1 behind HTTPS before sharing; default HTTP loopback development uses 0.
TAXI_SECURE_COOKIES=0
